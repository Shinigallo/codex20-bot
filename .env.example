# Codex20 OpenRouter - Configuration
# Copy this file to .env and fill in your values

# ============================================
# AI Configuration
# ============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_API_KEY_HERE

# Model configuration
MODEL_NAME=google/gemma-4-31b-it:free
BACKUP_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=3
OPENROUTER_DELAY=1.0
OPENROUTER_CACHE_TTL=120

# ============================================
# Security
# ============================================
# Admin user (change this!)
ADMIN_USERNAME=admin

# Admin password hash (generate with: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())")
ADMIN_PASSWORD_HASH=
# Example: ADMIN_PASSWORD_HASH=a1b2c3d4e5f6...

# JWT Secret (generate random: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# ============================================
# Bot Configuration (optional)
# ============================================
# Get your bot token from @BotFather
# TELEGRAM_TOKEN=

# ============================================
# Application
# ============================================
# Server ports
WEB_PORT=8084
BOT_PORT=8085

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///data/sessions.db
