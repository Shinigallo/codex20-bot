# Codex20 OpenRouter - Configurazione Non-Interattiva
# Copia questo file in .env e compila tutti i campi

# ============================================
# AI Configuration
# ============================================
# OpenRouter API Key (obbligatoria)
# Ottieni la tua chiave gratuita su: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model configuration
# Modello principale (default: google/gemma-4-31b-it:free)
MODEL_NAME=google/gemma-4-31b-it:free

# Modello di backup (default: nvidia/nemotron-3-ultra-550b-a55b:free)
BACKUP_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# ============================================
# Security
# ============================================
# Admin username (default: admin)
ADMIN_USERNAME=admin

# Admin password hash (SHA256)
# Genera con: python -c "import hashlib; print(hashlib.sha256('password'.encode()).hexdigest())"
ADMIN_PASSWORD_HASH=

# JWT Secret (casuale)
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ============================================
# Server
# ============================================
# Porta web (default: 8084)
WEB_PORT=8084

# Porta bot (default: 8085)
BOT_PORT=8085

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///data/sessions.db
